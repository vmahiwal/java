import org.apache.spark.sql.SparkSession
import org.apache.spark.sql.functions._

object Main {
  def main(args: Array[String]): Unit = {
    // Initialize SparkSession
    val spark = SparkSession.builder()
      .appName("Local DataFrame Example")
      .master("local[*]") // Run locally using all available cores
      .getOrCreate()

    // Sample data
    val data = Seq(
      (1, "John", 28),
      (2, "Jane", 34),
      (3, "Sam", 23)
    )

    // Define schema and create DataFrame
    import spark.implicits._
    val df = data.toDF("id", "name", "age")

    // Show the DataFrame
    df.show()

    // Example Transformation: Add a new column
    val updatedDF = df.withColumn("age_next_year", col("age") + 1)
    updatedDF.show()

    // Stop SparkSession
    spark.stop()
  }
}


















import org.apache.spark.sql.{SparkSession, DataFrame}
import org.apache.spark.sql.functions._

object SparkFilterExample {

  def main(args: Array[String]): Unit = {
    // Step 1: Create SparkSession
    val spark = SparkSession.builder()
      .appName("Spark Data Filter Example")
      .master("local[*]") // Run locally using all cores
      .getOrCreate()

    // Step 2: Read CSV file (Equivalent to tFileInputDelimited)
    val df: DataFrame = spark.read
      .option("header", "true")
      .option("inferSchema", "true")
      .csv("input.csv")

    // Step 3: Filter records where age > 30
    val filteredDf = df.filter(col("age") > 30)

    // Step 4: Select specific columns
    val resultDf = filteredDf.select("name", "age")

    // Step 5: Write to output CSV
    resultDf.write
      .option("header", "true")
      .mode("overwrite")
      .csv("output.csv")

    // Step 6: Stop SparkSession
    spark.stop()
  }
}
